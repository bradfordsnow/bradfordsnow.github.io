<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Tuner</title>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Tuner">
<meta name="theme-color" content="#000000">
<link rel="apple-touch-icon" href="icon.png">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }

:root {
  --green:  #3dff6e;
  --red:    #ff4040;
  --yellow: #ffd23f;
}

html, body {
  width:100%; height:100%;
  background:#000; color:#fff;
  font-family:'DM Sans',sans-serif;
  overflow:hidden; user-select:none;
}

.app {
  width:100%; max-width:420px; height:100dvh;
  margin:0 auto; display:flex; flex-direction:column;
  align-items:center; padding:0 32px;
  padding-top:env(safe-area-inset-top);
  padding-bottom:env(safe-area-inset-bottom);
}

#singleView {
  width:100%; display:flex; flex-direction:column;
  align-items:center; flex:1; padding-top:24px;
}

/* ── Note ── */
.note-section {
  flex:1; display:flex; flex-direction:column;
  align-items:center; justify-content:center;
}
.note-big {
  font-size:172px; font-weight:700; line-height:0.88;
  letter-spacing:-6px; color:rgba(255,255,255,0.09);
  transition:color 0.12s; text-align:center; min-width:220px;
}
.note-big.active  { color:#fff; }
.note-big.in-tune { color:var(--green); }
.note-big.sharp   { color:var(--red); }
.note-big.flat    { color:var(--yellow); }
.note-big.playing { color:rgba(255,255,255,0.7); animation:pulse 0.6s ease-in-out infinite alternate; }
@keyframes pulse { from{opacity:0.6} to{opacity:1} }

.cents-line {
  font-size:20px; font-weight:400;
  color:rgba(255,255,255,0.28); margin-top:10px;
  height:28px; transition:color 0.3s;
}
.cents-line.in-tune { color:var(--green); }

/* ── Meter ── */
.meter-section { width:100%; margin-bottom:30px; }

.meter-bar {
  width:100%; height:7px;
  background:rgba(255,255,255,0.07);
  border-radius:8px; position:relative; overflow:visible;
}
.meter-fill {
  position:absolute; top:0; bottom:0; border-radius:8px;
  width:0; left:50%; transition:background 0.12s; overflow:hidden;
}
.meter-tick {
  position:absolute; left:50%; top:50%;
  transform:translate(-50%,-50%);
  width:2px; height:19px; background:rgba(255,255,255,0.32);
  border-radius:1px; pointer-events:none; z-index:2;
}

/* ── Strobe — canvas based ── */
.strobe-wrap {
  width:100%; height:12px; border-radius:8px;
  background:rgba(255,255,255,0.03);
  position:relative; overflow:hidden; margin-top:5px;
}
.strobe-wrap canvas {
  position:absolute; inset:0; width:100%; height:100%; display:block;
}
.strobe-tick {
  position:absolute; left:50%; top:0; bottom:0;
  width:1px; background:rgba(255,255,255,0.22); z-index:3;
}

.meter-labels {
  display:flex; justify-content:space-between;
  align-items:center; margin-top:10px;
}
.meter-side {
  font-size:11px; font-weight:500; letter-spacing:0.1em;
  color:rgba(255,255,255,0.12); transition:color 0.12s;
}
.meter-side.lit-flat  { color:var(--yellow); }
.meter-side.lit-sharp { color:var(--red); }
.meter-center-label {
  font-size:11px; font-weight:500; letter-spacing:0.14em;
  color:rgba(255,255,255,0.15); transition:color 0.3s;
}
.meter-center-label.in-tune { color:var(--green); }

/* ── Strings ── */
.strings-section { width:100%; margin-bottom:0; position:relative; }

.strings-viewport { width:100%; overflow:hidden; touch-action:pan-y; }
.strings-strip    { display:flex; will-change:transform; }
.strings-row {
  display:grid; grid-template-columns:repeat(6,1fr);
  gap:4px; flex:0 0 100%; width:100%;
}

.str-btn {
  background:none; border:none; cursor:pointer;
  display:flex; flex-direction:column; align-items:center;
  gap:5px; padding:12px 0 10px; border-radius:12px;
  transition:background 0.15s;
}
.str-btn:active { background:rgba(255,255,255,0.05); }

.str-note {
  font-size:24px; font-weight:600;
  color:rgba(255,255,255,0.16); transition:color 0.15s; line-height:1;
}
.str-btn.active .str-note       { color:#fff; }
.str-btn.playing-tone .str-note { color:rgba(255,255,255,0.55); }
.str-note.capo-active           { color:var(--yellow); }

.str-index {
  font-size:10px; font-weight:400;
  color:rgba(255,255,255,0.08); letter-spacing:0.05em;
  transition:color 0.15s;
}
.str-btn.active .str-index { color:rgba(255,255,255,0.28); }

.str-pip {
  width:4px; height:4px; border-radius:50%;
  background:transparent; transition:background 0.15s;
}
.str-btn.active .str-pip { background:rgba(255,255,255,0.55); }

/* ── Top corner controls ── */
.top-row {
  width:100%;
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  padding-top:8px;
  position:relative;
  z-index:20;
}

.corner-btn {
  font-size:11px; font-weight:500; letter-spacing:0.08em;
  color:rgba(255,255,255,0.2); cursor:pointer;
  padding:4px 0; text-transform:uppercase;
  transition:color 0.15s; white-space:nowrap;
  background:none; border:none;
  font-family:'DM Sans',sans-serif;
}
.corner-btn.active { color:var(--yellow); }

/* Dropdown from top corners */
.corner-dropdown {
  position:absolute;
  top:calc(100% + 4px);
  background:#000;
  border:1px solid rgba(255,255,255,0.08);
  border-radius:10px;
  padding:6px 0;
  min-width:110px;
  opacity:0; pointer-events:none;
  transition:opacity 0.15s;
  z-index:30;
  overflow-y:auto;
  max-height:220px;
}
.corner-dropdown.open { opacity:1; pointer-events:all; }
.corner-dropdown.left  { left:0; }
.corner-dropdown.right { right:0; }

.cd-item {
  font-size:12px; font-weight:500;
  color:rgba(255,255,255,0.25);
  padding:7px 14px; cursor:pointer;
  transition:color 0.1s; white-space:nowrap;
  display:block;
}
.cd-item.left  { text-align:left; }
.cd-item.right { text-align:right; }
.cd-item:hover { color:rgba(255,255,255,0.5); }

/* ── Tuning name + dots (bottom of strings) ── */
.tuning-footer {
  text-align:center;
  margin-top:14px;
  padding-bottom:8px;
}
.tuning-line1 {
  font-size:12px; font-weight:500; letter-spacing:0.12em;
  color:rgba(255,255,255,0.25); text-transform:uppercase; display:block;
}
.tuning-line2 {
  font-size:11px; font-weight:400; letter-spacing:0.14em;
  color:rgba(255,255,255,0.13); text-transform:uppercase; display:block;
  margin-bottom:8px;
}
.tuning-dots {
  display:flex; justify-content:center; gap:6px;
}
.t-dot {
  width:4px; height:4px; border-radius:50%;
  background:rgba(255,255,255,0.12);
  transition:background 0.2s, transform 0.2s;
}
.t-dot.active { background:rgba(255,255,255,0.5); transform:scale(1.2); }

/* ── All-strings view ── */
#allView { display:none; width:100%; flex:1; flex-direction:column; align-items:center; }
#allView.visible { display:flex; }

.all-header {
  margin-top:20px; font-size:12px; font-weight:500;
  letter-spacing:0.18em; color:rgba(255,255,255,0.2); text-transform:uppercase;
}
.all-chart {
  flex:1; width:100%; display:flex; flex-direction:column;
  justify-content:center; padding:0 4px; margin-top:-10px;
}
.chart-body { position:relative; width:100%; height:200px; }
.center-line {
  position:absolute; left:0; right:0; top:50%; height:1px;
  background:rgba(255,255,255,0.18); transform:translateY(-50%);
}
.tune-zone {
  position:absolute; left:0; right:0; top:calc(50% - 6px); height:12px;
  background:rgba(61,255,110,0.06);
  border-top:1px solid rgba(61,255,110,0.12);
  border-bottom:1px solid rgba(61,255,110,0.12);
}
.bars-row {
  position:absolute; inset:0; display:grid;
  grid-template-columns:repeat(6,1fr); gap:10px; padding:0 6px; align-items:center;
}
.bar-col { height:100%; display:flex; align-items:center; justify-content:center; position:relative; }
.str-bar {
  width:14px; border-radius:7px; position:absolute;
  left:50%; transform:translateX(-50%);
  transition:height 0.1s, top 0.1s, background 0.15s;
  background:rgba(255,255,255,0.1);
}
.all-string-labels {
  display:grid; grid-template-columns:repeat(6,1fr);
  gap:10px; padding:0 10px; margin-top:12px;
}
.all-str-label { text-align:center; }
.all-str-note {
  font-size:22px; font-weight:600;
  color:rgba(255,255,255,0.2); line-height:1; transition:color 0.15s;
}
.all-str-note.in-tune { color:var(--green); }
.all-str-note.sharp   { color:var(--red); }
.all-str-note.flat    { color:var(--yellow); }
.all-str-note.heard   { color:rgba(255,255,255,0.55); }
.all-str-cents {
  font-size:10px; font-weight:400; color:rgba(255,255,255,0.15);
  margin-top:3px; height:14px; transition:color 0.15s;
}
.all-str-cents.in-tune { color:var(--green); }
.exit-all-btn {
  margin-bottom:max(28px,env(safe-area-inset-bottom));
  background:none; border:1px solid rgba(255,255,255,0.12);
  border-radius:20px; padding:10px 24px;
  font-family:'DM Sans',sans-serif; font-size:12px; font-weight:500;
  letter-spacing:0.1em; color:rgba(255,255,255,0.3); cursor:pointer;
  transition:color 0.2s, border-color 0.2s;
}
</style>
</head>
<body>
<div class="app">

  <!-- SINGLE VIEW -->
  <div id="singleView">

    <!-- Top corners: Capo (left) and A4 (right) -->
    <div class="top-row" id="topRow">
      <button class="corner-btn" id="capoBtn">No Capo</button>
      <button class="corner-btn" id="a4Btn">440</button>
      <!-- Dropdowns inside top-row so they anchor from it -->
      <div class="corner-dropdown left"  id="capoDropdown"></div>
      <div class="corner-dropdown right" id="a4Dropdown"></div>
    </div>

    <div class="note-section">
      <div class="note-big" id="noteBig">–</div>
      <div class="cents-line" id="centsLine"></div>
    </div>

    <div class="meter-section">
      <div class="meter-bar">
        <div class="meter-tick"></div>
        <div class="meter-fill" id="meterFill"></div>
      </div>
      <div class="strobe-wrap" id="strobeWrap">
        <canvas id="strobeCanvas"></canvas>
        <div class="strobe-tick"></div>
      </div>
      <div class="meter-labels">
        <span class="meter-side" id="lblFlat">Flat</span>
        <span class="meter-center-label" id="lblCenter">Listening</span>
        <span class="meter-side" id="lblSharp">Sharp</span>
      </div>
    </div>

    <div class="strings-section" id="stringsSection">
      <div class="strings-viewport" id="stringsViewport">
        <div class="strings-strip" id="stringsStrip"></div>
      </div>
      <div class="tuning-footer">
        <span class="tuning-line1" id="tuningLine1">Standard</span>
        <span class="tuning-line2">Tuning</span>
        <div class="tuning-dots" id="tuningDots"></div>
      </div>
      <!-- Small reserved space at bottom -->
      <div style="height:max(16px,env(safe-area-inset-bottom))"></div>
    </div>

  </div>

  <!-- ALL STRINGS VIEW -->
  <div id="allView">
    <div class="all-header">All Strings</div>
    <div class="all-chart">
      <div class="chart-body">
        <div class="tune-zone"></div>
        <div class="center-line"></div>
        <div class="bars-row" id="barsRow"></div>
      </div>
      <div class="all-string-labels" id="allLabels"></div>
    </div>
    <button class="exit-all-btn" id="exitAllBtn">Back to tuner</button>
  </div>

</div>
<script>
/* ═══════════════════════════════
   TUNINGS
═══════════════════════════════ */
const TUNINGS = [
  { key:'chromatic',  line1:'Chromatic',  chromatic:true, strings:[
    {note:'',freq:0,idx:'6'},{note:'',freq:0,idx:'5'},
    {note:'',freq:0,idx:'4'},{note:'',freq:0,idx:'3'},
    {note:'',freq:0,idx:'2'},{note:'',freq:0,idx:'1'}
  ]},
  { key:'standard',   line1:'Standard',   chromatic:false, strings:[
    {note:'E',freq:82.41,idx:'6'},{note:'A',freq:110.00,idx:'5'},
    {note:'D',freq:146.83,idx:'4'},{note:'G',freq:196.00,idx:'3'},
    {note:'B',freq:246.94,idx:'2'},{note:'e',freq:329.63,idx:'1'}
  ]},
  { key:'dropd',      line1:'Drop',       chromatic:false, strings:[
    {note:'D',freq:73.42,idx:'6'},{note:'A',freq:110.00,idx:'5'},
    {note:'D',freq:146.83,idx:'4'},{note:'G',freq:196.00,idx:'3'},
    {note:'B',freq:246.94,idx:'2'},{note:'e',freq:329.63,idx:'1'}
  ]},
  { key:'openg',      line1:'Open G',     chromatic:false, strings:[
    {note:'D',freq:73.42,idx:'6'},{note:'G',freq:98.00,idx:'5'},
    {note:'D',freq:146.83,idx:'4'},{note:'G',freq:196.00,idx:'3'},
    {note:'B',freq:246.94,idx:'2'},{note:'D',freq:293.66,idx:'1'}
  ]},
  { key:'dadgad',     line1:'DADGAD',     chromatic:false, strings:[
    {note:'D',freq:73.42,idx:'6'},{note:'A',freq:110.00,idx:'5'},
    {note:'D',freq:146.83,idx:'4'},{note:'G',freq:196.00,idx:'3'},
    {note:'A',freq:220.00,idx:'2'},{note:'D',freq:293.66,idx:'1'}
  ]},
  { key:'opend',      line1:'Open D',     chromatic:false, strings:[
    {note:'D',freq:73.42,idx:'6'},{note:'A',freq:110.00,idx:'5'},
    {note:'D',freq:146.83,idx:'4'},{note:'F#',freq:185.00,idx:'3'},
    {note:'A',freq:220.00,idx:'2'},{note:'D',freq:293.66,idx:'1'}
  ]},
  { key:'nashville',  line1:'Nashville',  chromatic:false, strings:[
    {note:'E',freq:164.81,idx:'6'},{note:'A',freq:220.00,idx:'5'},
    {note:'D',freq:293.66,idx:'4'},{note:'G',freq:392.00,idx:'3'},
    {note:'B',freq:246.94,idx:'2'},{note:'e',freq:329.63,idx:'1'}
  ]},
  { key:'all',        line1:'All Strings · Beta', chromatic:false, strings:[
    {note:'E',freq:82.41,idx:'6'},{note:'A',freq:110.00,idx:'5'},
    {note:'D',freq:146.83,idx:'4'},{note:'G',freq:196.00,idx:'3'},
    {note:'B',freq:246.94,idx:'2'},{note:'e',freq:329.63,idx:'1'}
  ]},
];

const NOTE_NAMES = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];
const NOTE_IDX   = {C:0,'C#':1,Db:1,D:2,'D#':3,Eb:3,E:4,F:5,'F#':6,Gb:6,G:7,'G#':8,Ab:8,A:9,'A#':10,Bb:10,B:11};

const CAPO_OPTIONS = [
  {val:-2, label:'−2  D'},
  {val:-1, label:'−1  Eb'},
  {val:0,  label:'No Capo'},
  {val:1,  label:'Fret 1'},{val:2,label:'Fret 2'},{val:3,label:'Fret 3'},
  {val:4,  label:'Fret 4'},{val:5,label:'Fret 5'},{val:6,label:'Fret 6'},{val:7,label:'Fret 7'},
];
const A4_MIN = 430, A4_MAX = 450;

/* ═══════════════════════════════
   STATE
═══════════════════════════════ */
let curTuningIdx  = 1; // default = Standard
let selStr        = 0;
let isAllMode     = false;
let isPlayingTone = false;
let playToneTimer = null;
let activePicker  = null;
let capoIdx       = 2; // default = No Capo (index 2)
let a4Hz          = 440;

// Audio
let audioCtx, analyser, srcNode, micStream, raf;
let toneCtx, toneOsc, toneGain;

// Pitch state
let lastRMS       = 0;
let peakRMS       = 0;
let onsetTimer    = null;
let onsetHoldOff  = false;
const ONSET_MS    = 125;
const REL_GATE    = 0.05;

// Consensus cents for slow display
let centsHistory  = [];
const HIST_N      = 4;
const AGREE_C     = 10;
let slowCents     = 0;
let slowNote      = '';

// Bar damping
let barTargetLeft  = 50;
let barTargetWidth = 0;
let barCurLeft     = 50;
let barCurWidth    = 0;
const BAR_DAMP     = 0.18;

// In-tune hold
let inTuneHold  = false;
let inTuneHoldT = null;

// Strobe
let strobeDrawOffset = 0;
const STROBE_BAND_W  = 18;
const STROBE_GAP     = 18;
const STROBE_REPEAT  = STROBE_BAND_W + STROBE_GAP;

// All-strings
let allState      = Array(6).fill(null).map(()=>({cents:null,lastSeen:0}));
let recentStrings = new Set();

/* ═══════════════════════════════
   ELEMENTS
═══════════════════════════════ */
const singleView   = document.getElementById('singleView');
const allView      = document.getElementById('allView');
const tuningLine1  = document.getElementById('tuningLine1');
const tuningDots   = document.getElementById('tuningDots');
const capoBtn      = document.getElementById('capoBtn');
const a4Btn        = document.getElementById('a4Btn');
const capoDropdown = document.getElementById('capoDropdown');
const a4Dropdown   = document.getElementById('a4Dropdown');
const topRow       = document.getElementById('topRow');
const noteBig      = document.getElementById('noteBig');
const centsLine    = document.getElementById('centsLine');
const meterFill    = document.getElementById('meterFill');
const strobeWrap   = document.getElementById('strobeWrap');
const strobeCanvas = document.getElementById('strobeCanvas');
const sCtx         = strobeCanvas.getContext('2d');
const lblFlat      = document.getElementById('lblFlat');
const lblSharp     = document.getElementById('lblSharp');
const lblCenter    = document.getElementById('lblCenter');
const strip        = document.getElementById('stringsStrip');
const viewport     = document.getElementById('stringsViewport');
const strSection   = document.getElementById('stringsSection');
const barsRow      = document.getElementById('barsRow');
const allLabels    = document.getElementById('allLabels');
const exitAllBtn   = document.getElementById('exitAllBtn');

/* ═══════════════════════════════
   STROBE CANVAS
═══════════════════════════════ */
function sizeStrobeCanvas() {
  strobeCanvas.width  = strobeWrap.offsetWidth;
  strobeCanvas.height = strobeWrap.offsetHeight;
}
sizeStrobeCanvas();
window.addEventListener('resize', sizeStrobeCanvas);

function drawStrobe(cents) {
  const W = strobeCanvas.width;
  const H = strobeCanvas.height;
  sCtx.clearRect(0, 0, W, H);

  const absCents = Math.abs(cents);
  const inTune   = absCents < 2;
  const sharp    = cents > 0;

  if (inTune) {
    sCtx.fillStyle = 'rgba(61,255,110,0.72)';
    sCtx.fillRect(0, 0, W, H);
    return;
  }

  // Speed proportional to cents — only speed changes, not band width
  const t     = Math.min(1, absCents / 50);
  const speed = 0.12 + 5.5 * Math.pow(t, 2.2);

  // Advance offset — sharp scrolls right (+), flat scrolls left (-)
  strobeDrawOffset += speed * (sharp ? 1 : -1);

  // Band color
  let r, g, b;
  if (t < 0.15)      { r=61;  g=255; b=110; }
  else if (t < 0.35) { r=sharp?180:255; g=sharp?220:210; b=sharp?70:63; }
  else               { r=sharp?255:255; g=sharp?64:210;  b=sharp?64:63; }

  // Walk left from strobeDrawOffset until off canvas, then tile right
  let x = strobeDrawOffset;
  while (x > -STROBE_BAND_W) x -= STROBE_REPEAT;
  while (x < W) {
    sCtx.fillStyle = `rgba(${r},${g},${b},0.80)`;
    sCtx.fillRect(Math.round(x), 0, STROBE_BAND_W, H);
    x += STROBE_REPEAT;
  }

  // Feather edges
  const fw  = Math.round(W * 0.22);
  const lg  = sCtx.createLinearGradient(0, 0, fw, 0);
  lg.addColorStop(0,    'rgba(0,0,0,1)');
  lg.addColorStop(0.55, 'rgba(0,0,0,0.35)');
  lg.addColorStop(1,    'rgba(0,0,0,0)');
  sCtx.fillStyle = lg;
  sCtx.fillRect(0, 0, fw, H);

  const rg = sCtx.createLinearGradient(W - fw, 0, W, 0);
  rg.addColorStop(0,    'rgba(0,0,0,0)');
  rg.addColorStop(0.45, 'rgba(0,0,0,0.35)');
  rg.addColorStop(1,    'rgba(0,0,0,1)');
  sCtx.fillStyle = rg;
  sCtx.fillRect(W - fw, 0, fw, H);
}

function clearStrobe() {
  const W = strobeCanvas.width;
  const H = strobeCanvas.height;
  sCtx.clearRect(0, 0, W, H);
}

/* ═══════════════════════════════
   CAPO / A4 UTILS
═══════════════════════════════ */
function capoSemitones() { return CAPO_OPTIONS[capoIdx].val; }

function transposeNote(name, semitones) {
  const base = name.replace(/\d/g,'');
  let idx = NOTE_IDX[base];
  if (idx === undefined) return name;
  idx = ((idx + semitones) % 12 + 12) % 12;
  const n = NOTE_NAMES[idx];
  if (semitones < 0) { const f={'C#':'Db','D#':'Eb','F#':'Gb','G#':'Ab','A#':'Bb'}; return f[n]||n; }
  return n;
}

function getStringNote(si) {
  const base = TUNINGS[curTuningIdx].strings[si].note;
  const s = capoSemitones();
  if (s === 0) return {note:base, transposed:false};
  return {note:transposeNote(base, s), transposed:true};
}

function getStringFreq(si) {
  const f = TUNINGS[curTuningIdx].strings[si].freq;
  const s = capoSemitones();
  return s === 0 ? f : f * Math.pow(2, s/12);
}

function adjustedFreq(f) { return f * (a4Hz / 440); }

/* ═══════════════════════════════
   CHROMATIC UTILS
═══════════════════════════════ */
function freqToMidi(f) { return Math.round(12 * Math.log2(f / a4Hz) + 69); }
function midiToFreq(m) { return a4Hz * Math.pow(2, (m-69)/12); }
function nearestNote(freq) {
  const midi = freqToMidi(freq);
  const name = NOTE_NAMES[((midi%12)+12)%12];
  const cents = 1200 * Math.log2(freq / midiToFreq(midi));
  return {name, cents};
}
function matchToString(freq) {
  const strings = TUNINGS[curTuningIdx].strings;
  let bestIdx=0, bestDist=Infinity;
  strings.forEach((s,i)=>{
    const target = adjustedFreq(getStringFreq(i));
    const d = Math.abs(1200*Math.log2(freq/target));
    if (d < bestDist) { bestDist=d; bestIdx=i; }
  });
  return {idx:bestIdx, dist:bestDist};
}

/* ═══════════════════════════════
   BUILD STRIP
═══════════════════════════════ */
function buildStrip() {
  strip.innerHTML = '';
  const isChromatic = TUNINGS[curTuningIdx].chromatic;

  TUNINGS.forEach((t, ti) => {
    const row = document.createElement('div');
    row.className = 'strings-row';

    if (ti === curTuningIdx && isChromatic) {
      row.style.minHeight = '56px';
    } else {
      t.strings.forEach((s, si) => {
        const b = document.createElement('button');
        const isActive  = ti === curTuningIdx && si === selStr;
        const isPlaying = isActive && isPlayingTone;
        b.className = 'str-btn' + (isActive?' active':'') + (isPlaying?' playing-tone':'');

        const {note, transposed} = (ti === curTuningIdx)
          ? getStringNote(si)
          : {note:s.note, transposed:false};

        b.innerHTML = `
          <div class="str-pip"></div>
          <div class="str-note${transposed?' capo-active':''}">${note}</div>
          <div class="str-index">${s.idx}</div>`;

        b.addEventListener('click', ()=>{
          if (ti !== curTuningIdx) return;
          closeAllDropdowns();
          if (isPlayingTone && si === selStr) {
            clearTimeout(playToneTimer); isPlayingTone=false;
            stopTone(); buildStrip(); resetUI(); return;
          }
          selStr = si; buildStrip(); triggerStringTone(si);
        });
        row.appendChild(b);
      });
    }
    strip.appendChild(row);
  });

  strip.style.transition = 'none';
  strip.style.transform  = `translateX(${-curTuningIdx * 100}%)`;
  tuningLine1.textContent = TUNINGS[curTuningIdx].line1;

  tuningDots.innerHTML = '';
  TUNINGS.forEach((t, ti) => {
    const dot = document.createElement('div');
    dot.className = 't-dot' + (ti === curTuningIdx ? ' active' : '');
    tuningDots.appendChild(dot);
  });
}

function updateStripPos(animate) {
  strip.style.transition = animate ? 'transform 0.35s cubic-bezier(0.32,0.72,0,1)' : 'none';
  strip.style.transform  = `translateX(${-curTuningIdx * 100}%)`;
}

function goToTuning(idx, animate=true) {
  const allIdx = TUNINGS.findIndex(t=>t.key==='all');
  curTuningIdx = Math.max(0, Math.min(TUNINGS.length-1, idx));
  selStr = 0; closeAllDropdowns();
  if (curTuningIdx === allIdx) { buildStrip(); resetUI(); enterAllMode(); }
  else { if (isAllMode) exitAllMode(); buildStrip(); resetUI(); }
}

/* ═══════════════════════════════
   CORNER DROPDOWN SYSTEM
═══════════════════════════════ */
function updateCapoLabel() {
  const val = CAPO_OPTIONS[capoIdx].val;
  if      (val ===  0) { capoBtn.textContent = 'No Capo'; capoBtn.classList.remove('active'); }
  else if (val === -1) { capoBtn.textContent = 'Eb';      capoBtn.classList.add('active'); }
  else if (val === -2) { capoBtn.textContent = '−2 D';    capoBtn.classList.add('active'); }
  else                 { capoBtn.textContent = 'Capo '+val; capoBtn.classList.add('active'); }
}

function updateA4Label() {
  a4Btn.textContent = a4Hz === 440 ? '440' : a4Hz+' Hz';
  if (a4Hz !== 440) a4Btn.classList.add('active');
  else              a4Btn.classList.remove('active');
}

function buildCapoDropdown() {
  capoDropdown.innerHTML = '';
  CAPO_OPTIONS.forEach((opt, i) => {
    const el = document.createElement('div');
    el.className = 'cd-item left';
    const isDefault  = opt.val === 0;
    const isSelected = i === capoIdx;
    el.style.color = isDefault ? '#fff' : isSelected ? '#ffd23f' : 'rgba(255,255,255,0.25)';
    el.textContent = opt.label;
    el.addEventListener('click', e => {
      e.stopPropagation();
      capoIdx = i;
      updateCapoLabel();
      buildStrip();
      closeAllDropdowns();
    });
    capoDropdown.appendChild(el);
  });
}

function buildA4DropdownList() {
  a4Dropdown.innerHTML = '';
  for (let hz = A4_MIN; hz <= A4_MAX; hz++) {
    const el = document.createElement('div');
    el.className = 'cd-item right';
    const isDefault  = hz === 440;
    const isSelected = hz === a4Hz;
    el.style.color = isDefault ? '#fff' : isSelected ? '#ffd23f' : 'rgba(255,255,255,0.25)';
    el.textContent = hz + ' Hz';
    el.addEventListener('click', e => {
      e.stopPropagation();
      a4Hz = hz;
      updateA4Label();
      Array.from(a4Dropdown.children).forEach((child, j) => {
        const h = A4_MIN + j;
        child.style.color = h === 440 ? '#fff' : h === a4Hz ? '#ffd23f' : 'rgba(255,255,255,0.25)';
      });
    });
    a4Dropdown.appendChild(el);
    if (isSelected) setTimeout(() => el.scrollIntoView({block:'center',behavior:'instant'}), 0);
  }
}

function closeAllDropdowns() {
  activePicker = null;
  capoDropdown.classList.remove('open');
  a4Dropdown.classList.remove('open');
}

capoBtn.addEventListener('click', e => {
  e.stopPropagation();
  const isOpen = capoDropdown.classList.contains('open');
  closeAllDropdowns();
  if (!isOpen) { buildCapoDropdown(); capoDropdown.classList.add('open'); activePicker='capo'; }
});

a4Btn.addEventListener('click', e => {
  e.stopPropagation();
  const isOpen = a4Dropdown.classList.contains('open');
  closeAllDropdowns();
  if (!isOpen) { buildA4DropdownList(); a4Dropdown.classList.add('open'); activePicker='a4'; }
});

document.addEventListener('click', () => closeAllDropdowns());
document.addEventListener('touchstart', e => {
  if (!topRow.contains(e.target) && !capoDropdown.contains(e.target) && !a4Dropdown.contains(e.target)) {
    closeAllDropdowns();
  }
}, {passive:true});

/* ═══════════════════════════════
   SWIPE
═══════════════════════════════ */
let tSX=0, tSY=0, dragging=false, dragDx=0;

function swipeStart(e) {
  tSX=e.touches[0].clientX; tSY=e.touches[0].clientY;
  dragging=false; dragDx=0; strip.style.transition='none';
}
function swipeMove(e) {
  const dx=e.touches[0].clientX-tSX, dy=e.touches[0].clientY-tSY;
  if (!dragging && Math.abs(dx)>Math.abs(dy) && Math.abs(dx)>6) { dragging=true; closeAllDropdowns(); }
  if (!dragging) return;
  dragDx=dx;
  strip.style.transform=`translateX(calc(${-curTuningIdx*100}% + ${dragDx}px))`;
}
function swipeEnd() {
  if (!dragging) return;
  const thresh = viewport.offsetWidth*0.22;
  if      (dragDx < -thresh && curTuningIdx < TUNINGS.length-1) goToTuning(curTuningIdx+1);
  else if (dragDx >  thresh && curTuningIdx > 0)                goToTuning(curTuningIdx-1);
  else updateStripPos(true);
  dragging=false; dragDx=0;
}

[viewport, strSection].forEach(el=>{
  el.addEventListener('touchstart', swipeStart, {passive:true});
  el.addEventListener('touchmove',  swipeMove,  {passive:true});
  el.addEventListener('touchend',   swipeEnd);
});

/* ═══════════════════════════════
   ALL-STRINGS MODE
═══════════════════════════════ */
function buildAllView() {
  barsRow.innerHTML=''; allLabels.innerHTML='';
  TUNINGS[1].strings.forEach((s,i)=>{
    const col=document.createElement('div'); col.className='bar-col';
    const bar=document.createElement('div'); bar.className='str-bar';
    bar.id='bar-'+i; bar.style.height='4px'; bar.style.top='calc(50% - 2px)';
    col.appendChild(bar); barsRow.appendChild(col);
    const lbl=document.createElement('div'); lbl.className='all-str-label';
    lbl.innerHTML=`<div class="all-str-note" id="aln-${i}">${s.note}</div><div class="all-str-cents" id="alc-${i}"></div>`;
    allLabels.appendChild(lbl);
  });
}
function updateAllBar(si, cents) {
  const bar=document.getElementById('bar-'+si);
  const noteEl=document.getElementById('aln-'+si);
  const cEl=document.getElementById('alc-'+si);
  if (!bar) return;
  const chartH=document.querySelector('.chart-body').offsetHeight;
  const half=chartH/2;
  const inTune=Math.abs(cents)<4, sharp=cents>4;
  const clamp=Math.max(-50,Math.min(50,cents));
  const barH=Math.max(4,Math.abs(clamp/50)*(half*0.82));
  bar.style.height=barH+'px';
  bar.style.background=inTune?'var(--green)':sharp?'var(--red)':'var(--yellow)';
  bar.style.top=clamp>=0?(half-barH)+'px':half+'px';
  noteEl.className='all-str-note'+(inTune?' in-tune':sharp?' sharp':' flat heard');
  cEl.textContent=(cents>=0?'+':'')+cents.toFixed(0)+'¢';
  cEl.className='all-str-cents'+(inTune?' in-tune':'');
}
function enterAllMode() {
  isAllMode=true; singleView.style.display='none';
  allView.classList.add('visible');
  allState=Array(6).fill(null).map(()=>({cents:null,lastSeen:0}));
  buildAllView();
}
function exitAllMode() {
  isAllMode=false; allView.classList.remove('visible');
  singleView.style.display=''; recentStrings.clear();
  curTuningIdx=1; buildStrip(); resetUI();
}
exitAllBtn.addEventListener('click', exitAllMode);

/* ═══════════════════════════════
   YIN PITCH DETECTION
═══════════════════════════════ */
function yin(buf, sr) {
  const SIZE=buf.length, HALF=Math.floor(SIZE/2), THRESH=0.20;
  let rms=0;
  for (let i=0;i<SIZE;i++) rms+=buf[i]*buf[i];
  rms=Math.sqrt(rms/SIZE);

  peakRMS = Math.max(peakRMS*0.995, rms);
  if (peakRMS < 0.003 || rms < peakRMS*REL_GATE) return null;

  const isOnset = rms > lastRMS*1.5 && rms > 0.01;
  lastRMS = rms;
  if (isOnset) {
    onsetHoldOff=true; clearTimeout(onsetTimer);
    onsetTimer=setTimeout(()=>{ onsetHoldOff=false; }, ONSET_MS);
    return null;
  }
  if (onsetHoldOff) return null;

  const diff=new Float32Array(HALF);
  for (let tau=1;tau<HALF;tau++) {
    for (let i=0;i<HALF;i++) { const d=buf[i]-buf[i+tau]; diff[tau]+=d*d; }
  }
  const cmnd=new Float32Array(HALF); cmnd[0]=1;
  let runSum=0;
  for (let tau=1;tau<HALF;tau++) {
    runSum+=diff[tau];
    cmnd[tau]=runSum===0?0:diff[tau]*tau/runSum;
  }
  const minTau=Math.floor(sr/1400), maxTau=Math.min(HALF-1,Math.floor(sr/55));
  let tau=minTau;
  while (tau<maxTau) {
    if (cmnd[tau]<THRESH) {
      while (tau+1<maxTau && cmnd[tau+1]<cmnd[tau]) tau++;
      const better=tau>0&&tau<HALF-1
        ? tau+(cmnd[tau+1]-cmnd[tau-1])/(2*(2*cmnd[tau]-cmnd[tau-1]-cmnd[tau+1]))
        : tau;
      return {freq:sr/better};
    }
    tau++;
  }
  let minVal=Infinity, minIdx=-1;
  for (let t=minTau;t<maxTau;t++) { if (cmnd[t]<minVal) { minVal=cmnd[t]; minIdx=t; } }
  if (minIdx>0 && minVal<0.5) return {freq:sr/minIdx};
  return null;
}

/* ═══════════════════════════════
   MIC
═══════════════════════════════ */
async function startMic() {
  try {
    micStream = await navigator.mediaDevices.getUserMedia({
      audio:{ echoCancellation:false, noiseSuppression:false, autoGainControl:true }
    });
    audioCtx = new (window.AudioContext||window.webkitAudioContext)();
    analyser = audioCtx.createAnalyser();
    analyser.fftSize = 8192;
    analyser.smoothingTimeConstant = 0.5;
    srcNode = audioCtx.createMediaStreamSource(micStream);
    srcNode.connect(analyser);
    lblCenter.textContent = 'Listening';
    loop();
  } catch(e) { lblCenter.textContent = 'No mic'; }
}

/* ═══════════════════════════════
   DETECT LOOP
═══════════════════════════════ */
let silF=0, idleT;

function loop() {
  const buf=new Float32Array(analyser.fftSize);
  function tick() {
    if (!audioCtx) return;
    raf=requestAnimationFrame(tick);
    if (isPlayingTone) { animateBar(); return; }

    analyser.getFloatTimeDomainData(buf);
    const result=yin(buf,audioCtx.sampleRate);

    if (result && result.freq>55 && result.freq<1500) {
      silF=0; clearTimeout(idleT);
      const {freq}=result;
      const nn=nearestNote(freq);

      if (isAllMode) {
        const {idx,dist}=matchToString(freq);
        if (dist<60) {
          const cents=1200*Math.log2(freq/adjustedFreq(getStringFreq(idx)));
          updateAllBar(idx,cents);
        }
      } else {
        const isChromatic = TUNINGS[curTuningIdx].chromatic;
        if (!isChromatic) {
          const {idx:ci,dist:cd}=matchToString(freq);
          if (cd<80 && ci!==selStr) { selStr=ci; buildStrip(); }
        }

        centsHistory.push(nn.cents);
        if (centsHistory.length>HIST_N) centsHistory.shift();
        if (centsHistory.length>=HIST_N) {
          const mn=Math.min(...centsHistory), mx=Math.max(...centsHistory);
          if (mx-mn<AGREE_C) { slowCents=centsHistory.reduce((a,b)=>a+b)/HIST_N; slowNote=nn.name; }
        }

        updateBarFast(nn.cents);
        if (slowNote) updateSlowDisplay(slowNote, slowCents);
        drawStrobe(nn.cents);
      }
    } else {
      silF++;
      if (silF>25) {
        centsHistory=[];
        clearTimeout(idleT);
        idleT=setTimeout(()=>{ if (!isAllMode&&!isPlayingTone) { slowCents=0;slowNote=''; resetUI(); } },2000);
      }
      if (!isPlayingTone) clearStrobe();
    }
    animateBar();
  }
  tick();
}

/* ═══════════════════════════════
   UI
═══════════════════════════════ */
function updateBarFast(cents) {
  const inTune=Math.abs(cents)<4, sharp=cents>4;
  const half=meterFill.parentElement.offsetWidth/2;
  const clamp=Math.max(-50,Math.min(50,cents));
  const fillW=Math.abs(clamp/50)*(half-4);
  barTargetLeft  = clamp<0 ? (half-fillW) : half;
  barTargetWidth = fillW;

  if (inTune) {
    if (!inTuneHold) { inTuneHold=true; clearTimeout(inTuneHoldT); inTuneHoldT=setTimeout(()=>{ inTuneHold=false; },500); }
  }
  const color=(inTune||inTuneHold)?'var(--green)':sharp?'var(--red)':'var(--yellow)';
  meterFill.style.background=color;
  lblFlat.className  = 'meter-side'+(!inTune&&!sharp&&!inTuneHold?' lit-flat':'');
  lblSharp.className = 'meter-side'+(!inTune&&sharp&&!inTuneHold?' lit-sharp':'');
}

function animateBar() {
  barCurLeft  += (barTargetLeft  - barCurLeft)  * BAR_DAMP;
  barCurWidth += (barTargetWidth - barCurWidth) * BAR_DAMP;
  meterFill.style.left  = barCurLeft  + 'px';
  meterFill.style.width = barCurWidth + 'px';
}

function updateSlowDisplay(note, cents) {
  const inTune=Math.abs(cents)<4||inTuneHold, sharp=cents>4;
  noteBig.textContent=note;
  noteBig.className='note-big'+(inTune?' in-tune':sharp?' sharp':note?' flat':'');
  if (note) {
    centsLine.textContent=(cents>=0?'+':'')+cents.toFixed(1)+'¢';
    centsLine.className='cents-line'+(inTune?' in-tune':'');
  }
  lblCenter.textContent=inTune?'In tune':'';
  lblCenter.className='meter-center-label'+(inTune?' in-tune':'');
}

function resetUI() {
  noteBig.className='note-big'; noteBig.textContent='–';
  centsLine.textContent=''; centsLine.className='cents-line';
  barTargetLeft=50; barTargetWidth=0; barCurLeft=50; barCurWidth=0;
  meterFill.style.left='50%'; meterFill.style.width='0';
  meterFill.style.background='transparent';
  lblFlat.className='meter-side'; lblSharp.className='meter-side';
  lblCenter.textContent='Listening'; lblCenter.className='meter-center-label';
  inTuneHold=false; clearTimeout(inTuneHoldT);
  clearStrobe();
}

/* ═══════════════════════════════
   TONE
═══════════════════════════════ */
function triggerStringTone(si) {
  clearTimeout(playToneTimer);
  isPlayingTone=true; buildStrip();
  const freq=adjustedFreq(getStringFreq(si));
  const {note}=getStringNote(si);
  noteBig.textContent=note; noteBig.className='note-big playing';
  centsLine.textContent=freq.toFixed(1)+' Hz'; centsLine.className='cents-line';
  barTargetWidth=0; meterFill.style.background='transparent';
  lblCenter.textContent='Playing'; lblCenter.className='meter-center-label';
  lblFlat.className='meter-side'; lblSharp.className='meter-side';
  clearStrobe();
  fadeOutAndPlay(freq);
  playToneTimer=setTimeout(()=>{ isPlayingTone=false; stopTone(); buildStrip(); resetUI(); },7200);
}

function fadeOutAndPlay(freq) {
  if (toneGain&&toneCtx) {
    const t=toneCtx.currentTime;
    toneGain.gain.cancelScheduledValues(t);
    toneGain.gain.setValueAtTime(toneGain.gain.value,t);
    toneGain.gain.linearRampToValueAtTime(0,t+0.08);
    const old=toneCtx; setTimeout(()=>old.close().catch(()=>{}),100);
    toneCtx=null; toneOsc=null; toneGain=null;
  }
  playTone(freq);
}

function playTone(freq) {
  toneCtx=new (window.AudioContext||window.webkitAudioContext)();
  const o1=toneCtx.createOscillator(), o2=toneCtx.createOscillator();
  const g=toneCtx.createGain(), g2=toneCtx.createGain();
  o1.type='triangle'; o1.frequency.value=freq;
  o2.type='sine';     o2.frequency.value=freq*2;
  g2.gain.value=0.14;
  o2.connect(g2); g2.connect(g); o1.connect(g); g.connect(toneCtx.destination);
  const t=toneCtx.currentTime;
  g.gain.setValueAtTime(0,t);
  g.gain.linearRampToValueAtTime(0.68,t+0.03);
  g.gain.setValueAtTime(0.68,t+6.5);
  g.gain.exponentialRampToValueAtTime(0.001,t+7);
  o1.start(t); o2.start(t); o1.stop(t+7.1); o2.stop(t+7.1);
  toneOsc=o1; toneGain=g;
}

function stopTone() {
  if (toneGain&&toneCtx) {
    const t=toneCtx.currentTime;
    toneGain.gain.cancelScheduledValues(t);
    toneGain.gain.setValueAtTime(toneGain.gain.value,t);
    toneGain.gain.linearRampToValueAtTime(0,t+0.08);
    const old=toneCtx; setTimeout(()=>old.close().catch(()=>{}),100);
  }
  toneCtx=null; toneOsc=null; toneGain=null;
}

/* ═══════════════════════════════
   INIT
═══════════════════════════════ */
buildStrip();
updateCapoLabel();
updateA4Label();

document.addEventListener('touchstart', function onFirst() {
  document.removeEventListener('touchstart', onFirst);
  startMic();
}, {passive:true});

if (!('ontouchstart' in window)) startMic();
</script>
